<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.trading.bot.android.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_chart"
        android:name="com.trading.bot.android.ui.chart.ChartFragment"
        android:label="Chart"
        tools:layout="@layout/fragment_chart" />

    <fragment
        android:id="@+id/nav_signals"
        android:name="com.trading.bot.android.ui.signals.SignalsFragment"
        android:label="Signals"
        tools:layout="@layout/fragment_signals" />

    <fragment
        android:id="@+id/nav_options"
        android:name="com.trading.bot.android.ui.options.OptionsFragment"
        android:label="Stats"
        tools:layout="@layout/fragment_options" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.trading.bot.android.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
