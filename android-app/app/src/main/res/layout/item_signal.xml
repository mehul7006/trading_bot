<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSignal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#161B22"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Symbol + Status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSymbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NIFTY50"
                android:textColor="#E6EDF3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="#21262D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="OPEN"
                android:textColor="#E3B341"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="#1F6FEB"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Direction -->
        <TextView
            android:id="@+id/tvDirection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="▲ BUY"
            android:textColor="#00D964"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Price details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entry: 0.00"
                android:textColor="#E6EDF3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Target: 0 pts → 0.00"
                android:textColor="#00D964"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="SL: 0 pts → 0.00"
                android:textColor="#FF4444"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Bottom: Elapsed -->
        <TextView
            android:id="@+id/tvElapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 min ago"
            android:textColor="#8B949E"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
