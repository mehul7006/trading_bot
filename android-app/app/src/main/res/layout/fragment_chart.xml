<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Symbol Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabSymbols"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#161B22"
        app:tabTextColor="#8B949E"
        app:tabSelectedTextColor="#E6EDF3"
        app:tabIndicatorColor="#1F6FEB"
        app:tabIndicatorHeight="3dp"
        app:tabTextAppearance="@style/TextAppearance.Tab" />

    <!-- Indicator Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#161B22">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="RSI: --"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAdx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="ADX: --"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMacd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="MACD: --"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVwap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="VWAP: --"
                android:textColor="#E3B341"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEma20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="EMA20: --"
                android:textColor="#1F6FEB"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAtr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="ATR: --"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#E3B341"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressChart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Candlestick Chart -->
    <com.github.mikephil.charting.charts.CombinedChart
        android:id="@+id/candleChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="#161B22" />

    <!-- Volume Chart -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/volumeChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D1117" />

</LinearLayout>
